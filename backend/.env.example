# ==========================================
# SEA KART BACKEND ENVIRONMENT CONFIGURATION
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB URI)
# Replace with your local MongoDB connection or MongoDB Atlas connection string
DATABASE_URL="mongodb://127.0.0.1:27017/seakart"

# Admin Authentication
ADMIN_PASSWORD="your_admin_password_here"
JWT_SECRET="your_jwt_secret_key_here"

# Payment Gateway (Razorpay API Credentials)
RAZORPAY_KEY_ID="rzp_test_YourTestKeyHere"
RAZORPAY_KEY_SECRET="YourTestSecretHere"

# Email Notifications (Nodemailer Gmail Transporter)
GMAIL_USER="your_email@gmail.com"
GMAIL_PASS="your_gmail_app_password"
